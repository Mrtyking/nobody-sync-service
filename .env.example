# ════════════════════════════════════════════════════════════════════════
#  Nobody Sync — lo que TIENES que poner
#  Copia este archivo a .env (o pega estas variables en el panel del hosting).
#  Lo de aqui arriba es lo importante; lo opcional esta al final, comentado.
# ════════════════════════════════════════════════════════════════════════

# ── Discord (obligatorio) ─────────────────────────────────────────────────
# Token del bot: Portal de desarrolladores → tu app → Bot → Reset Token
DISCORD_TOKEN=
# Application ID: Portal de desarrolladores → tu app → General Information
DISCORD_CLIENT_ID=
# Tu servidor: hace que los comandos aparezcan al instante. Vacio = hasta 1 hora.
DISCORD_GUILD_ID=

# ── Emoji que rescata (importante) ────────────────────────────────────────
# DEJALO VACIO para que funcione con CUALQUIER emoji (lo recomendado).
# Si pones alguno, SOLO esos disparan y el resto se ignora.
TRIGGER_EMOJIS=

# ── Registro de rescates (recomendado) ────────────────────────────────────
# Webhook de Discord donde llega un aviso por cada archivo rescatado, con su id
# y el propio archivo. Es un SECRETO: ponlo aqui o en las Variables del
# hosting, nunca en el repo. Vacio = registro desactivado.
LOG_WEBHOOK_URL=


# ════════════════════════════════════════════════════════════════════════
#  OPCIONALES — ya funcionan sin tocarlas. Descomenta solo la que quieras
#  cambiar. Dejar una VACIA es lo mismo que no ponerla.
# ════════════════════════════════════════════════════════════════════════
# BRAND_NAME=Nobody Sync          # marca del panel, del dispositivo y de los mensajes
# PANEL_GIF=assets/nobody.gif     # GIF de cabecera del panel
# PANEL_COLOR=#5865F2             # color de la barra del panel
# MEDIA_TTL_HOURS=24              # horas que se guardan los archivos
# CAPTURE_STATUS=true             # recuperar tambien los estados al reaccionarles
# ALLOW_GUEST_REACTIONS=false     # NO recomendado: atender reacciones de otros hace
#                                 # que tu cuenta les mande el archivo a ellos
# NOTIFY_CAPTURES=true            # aviso por DM en Discord por cada rescate
# DATA_DIR=./data                 # carpeta persistente de sesiones y archivos
# BAILEYS_LOG_LEVEL=silent        # silent | error | warn | info | debug
#
# El tamano y los colores del QR, y los colores del panel de estado, ya no son
# variables: son constantes en src/config.js, porque no se cambian nunca.
