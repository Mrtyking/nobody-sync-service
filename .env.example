# ─── Discord ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: si lo pones, los comandos se registran solo en ese servidor (al instante).
# Si lo dejas vacio, se registran globalmente (puede tardar hasta 1 hora).
DISCORD_GUILD_ID=

# ─── Marca / apariencia ───────────────────────────────────────────────────
BRAND_NAME=Nobody Sync
PANEL_COLOR=#5865F2
# GIF de cabecera del panel. Ruta relativa al proyecto o absoluta.
PANEL_GIF=assets/nobody.gif

# Colores del panel de estado segun la salud del servicio
STATUS_OK_COLOR=#3BA55D
STATUS_WARN_COLOR=#F0B232
STATUS_DOWN_COLOR=#ED4245

# ─── Codigo QR ────────────────────────────────────────────────────────────
QR_SIZE=1024
QR_MARGIN=2
QR_DARK=#0B0B0F
QR_LIGHT=#FFFFFF
# Milisegundos que dura cada QR antes de renovarse
QR_TIMEOUT_MS=60000

# ─── Captura de "una sola vez" ────────────────────────────────────────────
# Horas que se guardan los archivos en disco antes de borrarse
MEDIA_TTL_HOURS=24
# Emojis que activan el envio, tanto respondiendo al mensaje como reaccionando.
# DEJALO VACIO para que funcione con CUALQUIER emoji (lo recomendado). Si pones
# alguno aqui, SOLO esos disparan y el resto se ignora. Ejemplo: TRIGGER_EMOJIS=⭐,📥
TRIGGER_EMOJIS=
# Permitir que otros participantes (no el dueno de la sesion) reciban la copia en su chat
ALLOW_GUEST_REACTIONS=true
# Avisar por DM en Discord cada vez que se rescata un archivo
NOTIFY_CAPTURES=true

# ─── Registro administrativo ──────────────────────────────────────────────
# Webhook de Discord al que se envia un aviso por cada archivo rescatado, con
# su id. Es un SECRETO: no lo subas al repositorio, ponlo aqui o en el panel de
# variables del hosting. Vacio = registro desactivado.
# Ejemplo: LOG_WEBHOOK_URL=https://discord.com/api/webhooks/123.../abc...
LOG_WEBHOOK_URL=

# ─── Almacenamiento ───────────────────────────────────────────────────────
# Carpeta persistente. En Veltramon dejala dentro del directorio del servidor.
DATA_DIR=./data

# ─── Logs ─────────────────────────────────────────────────────────────────
# silent | error | warn | info | debug
# Con "debug" se dejan pasar tambien los volcados internos de libsignal
# (cientos de lineas por mensaje). Solo para depurar fallos de cifrado.
BAILEYS_LOG_LEVEL=silent
