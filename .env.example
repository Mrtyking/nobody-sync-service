# ════════════════════════════════════════════════════════════════════════
#  Nobody Sync — lo que TIENES que poner
#  Copia este archivo a .env (o pega estas variables en el panel del hosting).
#  Lo de aqui arriba es lo importante; lo opcional esta al final, comentado.
# ════════════════════════════════════════════════════════════════════════

# ── Discord (obligatorio) ─────────────────────────────────────────────────
# Token del bot: Portal de desarrolladores → tu app → Bot → Reset Token
DISCORD_TOKEN=
# Application ID: Portal de desarrolladores → tu app → General Information
DISCORD_CLIENT_ID=
# Tu servidor: hace que /setpanel aparezca al instante. Vacio = hasta 1 hora.
DISCORD_GUILD_ID=

# ── Emoji que rescata (importante) ────────────────────────────────────────
# DEJALO VACIO para que funcione con CUALQUIER emoji (lo recomendado).
# Si pones alguno, SOLO esos disparan y el resto se ignora.
TRIGGER_EMOJIS=

# ── Registro de rescates (recomendado) ────────────────────────────────────
# Webhook de Discord donde llega un aviso por cada archivo rescatado, con su id.
# Es un SECRETO: ponlo aqui o en las Variables del hosting, nunca en el repo.
# Vacio = registro desactivado.
LOG_WEBHOOK_URL=


# ════════════════════════════════════════════════════════════════════════
#  OPCIONALES — ya funcionan con estos valores. Descomenta solo si quieres
#  cambiar algo. Explicacion completa en el README.
# ════════════════════════════════════════════════════════════════════════
# BRAND_NAME=Nobody Sync            # nombre en el panel y el dispositivo vinculado
# BRAND_TAG=𝐍𝐨𝐛𝐨𝐝𝐲 𝐒𝐲𝐧𝐜            # firma al pie de los mensajes de WhatsApp
# PANEL_COLOR=#5865F2
# PANEL_GIF=assets/nobody.gif
# ALLOW_GUEST_REACTIONS=true      # que otros del grupo reciban su copia
# NOTIFY_CAPTURES=true            # aviso por DM en Discord por cada rescate
# MEDIA_TTL_HOURS=24              # horas que se guardan los archivos
# QR_TIMEOUT_MS=60000            # cada cuanto se renueva el codigo QR
# DATA_DIR=./data                # carpeta persistente de sesiones y archivos
# BAILEYS_LOG_LEVEL=silent       # silent | error | warn | info | debug
